<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="FreePersistenceUnit" transaction-type="JTA">
        <jta-data-source>FreeDataSource</jta-data-source>
        <class>com.oracle.helidonapps.productservice.Pokemon</class>
        <class>com.oracle.helidonapps.productservice.PokemonType</class>
        <class>com.oracle.helidonapps.productservice.entities.Category</class>
        <properties>
            <property name="hibernate.column_ordering_strategy" value="legacy"/>
            <property name="jakarta.persistence.sql-load-script-source" value="META-INF/init_script.sql"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
